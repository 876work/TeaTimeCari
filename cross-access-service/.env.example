# Cross-Access Service — Stage 1 (dummy data)
# Copy to .env to override defaults. Every value here is SAFE and LOCAL.
# There are intentionally NO production Supabase or Discourse credentials in Stage 1.

PORT=4300

# Shared secret used to sign the DiscourseConnect sync_sso payload.
# In Stage 1 this signs calls to the *mock* Discourse endpoint only.
# In Stage 2+ this becomes the real DISCOURSE_SSO_SECRET (set as a server secret, never committed).
DISCOURSE_SSO_SECRET=stage1-dummy-sso-secret-do-not-use-in-prod

# The Discourse group that represents cross-gender access.
# Matches the production XACCESS_GROUP convention documented in docs/discourse-permissions.md.
XACCESS_GROUP=xaccess

# How often the revocation worker sweeps for expired grants (milliseconds).
# Short interval so you can watch grants expire live in the demo.
WORKER_INTERVAL_MS=5000

# Stage 1 points at an in-process MOCK Discourse. Leave blank to use the mock.
# In Stage 2+ set this to a sandbox Discourse base URL.
DISCOURSE_BASE_URL=

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discourse SSO Configuration
DISCOURSE_BASE_URL=https://forum.example.com
DISCOURSE_ADMIN_API_KEY=your-discourse-admin-api-key
DISCOURSE_ADMIN_API_USERNAME=sassy-admin
DISCOURSE_SSO_SECRET=your-shared-sso-secret

# Site Configuration
SITE_BASE_URL=https://your-app.netlify.app

# Discourse Groups
MEN_GROUP=men-SLU
WOMEN_GROUP=women-SLU
XACCESS_GROUP=xaccess-SLU

# Discourse Settings
SEND_DISCOURSE_ACTIVATION=true

# Optional: Stripe Configuration (if using payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Optional: Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Optional: SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# KYC JWT Secret (for verification tokens)
KYC_JWT_SECRET=your-jwt-secret-for-kyc-tokens

# SSO Complete Function URL
VITE_SSO_COMPLETE_URL=https://nxzfrnpsiqpxibhggoct.functions.supabase.co/sso-complete
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Discourse SSO Configuration
DISCOURSE_BASE_URL=https://forum.example.com
DISCOURSE_ADMIN_API_KEY=your-discourse-admin-api-key
DISCOURSE_ADMIN_API_USERNAME=sassy-admin
DISCOURSE_SSO_SECRET=your-shared-sso-secret

# Site Configuration
SITE_BASE_URL=https://your-app.netlify.app

# Optional: PostHog Analytics
VITE_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Discourse Groups
MEN_GROUP=men-SLU
WOMEN_GROUP=women-SLU
XACCESS_GROUP=xaccess-SLU

# Discourse Settings
SEND_DISCOURSE_ACTIVATION=true

# Optional: Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Optional: Email Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Optional: SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# KYC JWT Secret
KYC_JWT_SECRET=your-jwt-secret-for-kyc-tokens

# SSO Complete Function URL
VITE_SSO_COMPLETE_URL=https://vdfzpdjplyhaotzkbyja.functions.supabase.co/sso-complete

# Discourse category landing paths after app login
VITE_DISCOURSE_BASE_URL=https://community.teatimecari.app
VITE_DISCOURSE_MEN_CATEGORY_PATH=/c/user-photos/men-photos-slu/6
VITE_DISCOURSE_WOMEN_CATEGORY_PATH=/c/user-photos/women-photos-slu/7
VITE_DISCOURSE_DEFAULT_RETURN_PATH=/